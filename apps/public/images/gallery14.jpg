<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#713f12"/>
      <stop offset="100%" style="stop-color:#ca8a04"/>
    </linearGradient>
    <filter id="shadow"><feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.3"/></filter>
  </defs>
  <rect width="600" height="400" fill="url(#g)" rx="16"/>
  <circle cx="300" cy="180" r="50" fill="white" opacity="0.15"/>
  <text x="300" y="190" text-anchor="middle" font-size="48" filter="url(#shadow)">🏪</text>
  <text x="300" y="240" text-anchor="middle" font-family="sans-serif" font-size="24" font-weight="bold" fill="white" filter="url(#shadow)">گالری 14</text>
  <text x="300" y="268" text-anchor="middle" font-family="sans-serif" font-size="14" fill="white" opacity="0.7">کارگاه</text>
</svg>