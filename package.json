{
  "name": "amozesh",
  "version": "0.1.0",
  "private": true,
  "description": "سامانه جامع مدیریت آموزشگاه هوشمند - Smart School Management Platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "cd apps/web && next dev --turbopack",
    "build": "cd apps/web && next build",
    "start": "cd apps/web && next start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "echo 'monorepo root'"
  },
  "dependencies": {
    "next": "15.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@amozesh/config": "workspace:*",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.2"
  }
}
