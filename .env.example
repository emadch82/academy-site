################################################################################
# سامانه آموزشگاه هوشمند — نمونه‌ی متغیرهای محیطی
# این فایل را به .env کپی کرده و مقادیر را پر کنید (هرگز .env را commit نکنید)
################################################################################

# ── کلیات ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
APP_NAME="سامانه آموزشگاه هوشمند"
APP_URL=http://localhost:8080
API_URL=http://localhost:8000
CLIENT_URL=http://localhost:8080

# ── دیتابیس (MongoDB) ──────────────────────────────────────────────────────
# در توسعه از docker-compose.dev.yml استفاده کنید
MONGODB_URI=mongodb://amozesh:amozesh_pass@localhost:27017/amozesh?authSource=admin
MONGODB_TEST_URI=mongodb://amozesh:amozesh_pass@localhost:27017/amozesh_test?authSource=admin

# ── امنیت / JWT ────────────────────────────────────────────────────────────
# حداقل ۳۲ کاراکتر رندوم (در prod با `openssl rand -base64 64` بسازید)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_aaaa
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_aaaa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long_aaaa
# دامنه‌ی cookie (در prod: yourdomain.com)
COOKIE_DOMAIN=localhost

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=amozesh_minio_access
S3_SECRET_KEY=amozesh_minio_secret_key
S3_BUCKET=amozesh
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/amozesh

# ── درگاه پرداخت (ایران) ───────────────────────────────────────────────────
# provider: zarinpal | idpay
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=your_idpay_api_key
IDPAY_SANDBOX=true

# ── پیامک (کاوه‌نگار) ──────────────────────────────────────────────────────
KAVENEGAR_API_KEY=your_kavenegar_api_key
KAVENEGAR_SENDER=1000596446

# ── ایمیل ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="سامانه آموزشگاه <noreply@example.com>"

# ─ـ هوش مصنوعی (فعلاً mock) ────────────────────────────────────────────────
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Realtime (Socket.IO) ───────────────────────────────────────────────────
SOCKET_IO_CORS_ORIGIN=http://localhost:8080

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─ـ لاگ ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
